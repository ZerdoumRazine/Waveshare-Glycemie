# EN: Board-revision-specific defaults; do not reuse blindly on ESP32-P4 rev3.x.
# FR: Réglages propres à la révision v1.3, non validés sur rev3.x.
# ESP32-P4 rev1.3-family compatibility profile (minimum 1.0 granularity).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
